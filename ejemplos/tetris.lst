  100  0156                     delay proc  
  101  0156                     delaying:   
  102                              ;GET SYSTEM TIME.
  103  0156   B4 2C               mov  ah, 2ch
  104  0158   CD 21               int  21h      ;?ï¿½ï¿½ RETURN SECONDS IN DH.
  105                              ;CHECK IF ONE SECOND HAS PASSED. 
  106  015A   3A 36 DA 2E         cmp  dh, seconds  ;?ï¿½ï¿½ IF SECONDS ARE THE SAME...
  107  015E   74 F6               je   delaying     ;    ...WE ARE STILL IN THE SAME SECONDS.
  108  0160   88 36 DA 2E         mov  seconds, dh  ;?ï¿½ï¿½ SECONDS CHANGED. PRESERVE NEW SECONDS.
  109  0164   C3                  ret
  110                              delay endp
