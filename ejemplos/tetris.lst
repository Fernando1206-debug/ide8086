 1408  118F   B4 00                MOV AH, 00h  ; interrupts to get system time        
 1409  1191   CD 1A                INT 1AH      ; CX:DX now hold number of clock ticks since midnight      
 1410  1193   89 D0                mov  ax, dx
 1411  1195   31 D2                xor  dx, dx
 1412  1197   B9 05 00             mov  cx, 5    
 1413  119A   F7 F1                div  cx       ; here dx contains the remainder of the division - from 0 to 4
 1414  119C   88 16 D3 2E          mov random_incoming1_shape_number, dl 
 1415  11A0   E8 C2 EF             call delay_2
 1416  11A3   B4 00                MOV AH, 00h  ; interrupts to get system time        
