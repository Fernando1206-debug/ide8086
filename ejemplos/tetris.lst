 1421  11AE   F7 F1                div  cx       ; here dx contains the remainder of the division - from 0 to 4
 1422  11B0   88 16 D4 2E          mov random_incoming2_shape_number, dl
 1423  11B4   C3                   ret
 1424                              endp genrate_random_number_init 
